# M-Pesa / Safaricom
MPESA_SHORTCODE=7599910

# Optional protection for ERP polling endpoints.
# If you set this, your ERP must send X-API-Key with the same value.
WEBHOOK_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE

# Railway volume path. Add a Railway Volume mounted at /data
DB_PATH=/data/mpesa_payments.db

# Optional:
# ERP_WEBHOOK_URL=https://your-erp-domain.example/api/mpesa
# ERP_API_KEY=...
